# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Supabase Auth. Obtain these from the Supabase project settings.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Server-only credentials. Never expose these through NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
WORKER_SECRET=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-at-least-32-random-characters

# Storage
DATASET_BUCKET=dataset-files
DEFECT_REFERENCE_BUCKET=defect-references
SIGNED_URL_TTL_SECONDS=300
MAX_IMAGE_COUNT=10000
API_KEY_REQUESTS_PER_MINUTE=120

# Worker timing
WORKER_STALE_SECONDS=180
JOB_HEARTBEAT_SECONDS=20
# Shared volume where the trusted local worker writes completed packages.
WORKER_OUTPUT_ROOT=./var/worker-output
RENDER_ENGINE_VERSION=v2

# Optional email provider. Invitations are disabled when these are blank.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000

# Optional RunPod adapter. Local polling remains the default when absent.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_CALLBACK_SECRET=
