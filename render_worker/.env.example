API_URL=http://localhost:8000
WORKER_SECRET=replace-with-the-same-strong-secret-as-the-backend
WORKER_NAME=local-blender-worker
WORKER_ORGANIZATION_ID=
BLENDER_EXECUTABLE=blender
RENDER_ENGINE_PATH=../render_engine/main.py
RENDER_ENGINE_V2_PATH=../render_engine/v2/main.py
RENDER_ENGINE_VERSION=v2
OUTPUT_ROOT=../backend/var/worker-output
POLL_SECONDS=3
BASE_SEED=8675309

# Optional image editing: a nonempty key enables clean-render + masked Gemini edits.
# Put your actual key in .env.gemini.local (ignored by git), never in frontend env.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_SECONDS=180
